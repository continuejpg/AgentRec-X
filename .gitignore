# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
# Environment variants (ranker / backend / embedding venvs) are machine-local
# rebuildable environments and must never be committed.  `.venv/` above covers the
# canonical one; this keeps the sibling variants equally invisible.
.venv-*/

# IDE
.vscode/
.idea/

# Secrets
.env
.env.*
# The committed example holds no credential and documents the opt-in switches; without this
# exception the `.env.*` rule would hide it, and a real `.env` still stays ignored.
!.env.example
*.key

# Data
# `data/` holds the real Amazon Reviews 2023 archives, downloaded samples and
# the generated processed artifacts. None of it belongs in git: the archives
# are multi-GB and the artifacts are regenerable from them. The pipeline creates
# data/raw/ and data/processed/ on demand, so nothing here needs a .gitkeep.
data/
*.jsonl
*.jsonl.gz

# ESCI external evaluation archive: only the frozen per-query/failure JSONL results
# are committed (all rows); raw data, embeddings and run logs remain ignored.
!experiments/esci_external/results/esci_per_query.jsonl.gz
!experiments/esci_external/results/esci_failures.jsonl.gz
*.parquet
*.feather
*.arrow
*.tsv

# Experiment outputs (Milestone 5+): run manifests, training logs, metric history.
# `data/` already covers processed artifacts; checkpoints are covered below.
logs/
runs/
artifacts/

# Models
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
*.pkl
*.pickle
*.npy
*.npz
checkpoints/
runs/
outputs/
wandb/

# Runtime memory store (Milestone 9). The SQLite preference-memory database is
# generated at runtime and must never be committed; tests use temp dirs or :memory:.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Cache
.cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# OS
.DS_Store

# M4 provider credential (local only, never committed)
.m4_credential

# P14-A committed test fixtures.  data/ and *.jsonl above intentionally exclude all
# real data/artifacts; the small, reviewable JSONL fixtures under tests/data/p14a are the
# exception (they are required for the offline test suite to run on a fresh checkout).
!tests/data/
!tests/data/p14a/
!tests/data/p14a/*.jsonl

# Archive round (2026-11-09): large model weights and local training adapters are
# machine-specific artifacts and must never enter the Git archive. The small JSON
# metrics under training/agent_sft/output/ remain commit-able; only the tarballs
# are excluded. The BGE model directory is restored from HuggingFace as documented
# in docs/ARCHIVE_MANIFEST.md.  Anchor this to the repository root: a bare `models/`
# pattern would also hide source packages such as recommendation/models/.
/models/
training/agent_sft/output/*.tar.gz
